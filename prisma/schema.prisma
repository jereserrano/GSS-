// This is your Prisma schema file for PROMPT MAESTRO
// SENA Regional Magdalena — Integración con la Media Técnica

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// GESTIÓN INSTITUCIONAL
// ============================================================

model Institucion {
  id            String   @id @default(cuid())
  nit           String   @unique
  nombre        String
  municipio     String
  departamento  String   @default("Magdalena")
  direccion     String
  telefono      String?
  email         String?
  rector        String?
  estado        Estado   @default(ACTIVO)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  sedes    Sede[]
  fichas   Ficha[]
  docentes Docente[]
  usuarios User[]
  documentos Documento[]

  @@map("instituciones")
}

model Sede {
  id            String   @id @default(cuid())
  nombre        String
  institucionId String
  direccion     String?
  barrio        String?
  municipio     String?
  esPrincipal   Boolean  @default(false)
  coordinador   String?
  telefono      String?
  estado        Estado   @default(ACTIVO)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  institucion Institucion @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  fichas      Ficha[]
  usuarios    User[]

  @@map("sedes")
}

model Programa {
  id             String             @id @default(cuid())
  codigo         String             @unique
  nombre         String
  nivelFormacion NivelFormacion     @default(TECNICO)
  estado         Estado             @default(ACTIVO)
  // Diseño Curricular
  version        String? // Versión del diseño curricular (ej: "3")
  duracion       Int? // Horas totales del programa
  modalidad      ModalidadPrograma? // Presencial, Virtual, etc.
  area           String? // Área de conocimiento
  areaDesempeno  String? // Sector productivo
  titulacion     String? // Certificado/título que se otorga
  descripcion    String?            @db.Text
  perfilIngreso  String?            @db.Text
  perfilEgresado String?            @db.Text
  creadoEn       DateTime           @default(now())
  actualizadoEn  DateTime           @updatedAt

  competencias Competencia[]
  fichas       Ficha[]

  @@map("programas")
}

model Ficha {
  id            String   @id @default(cuid())
  codigo        String   @unique
  programaId    String
  institucionId String
  sedeId        String
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        Estado   @default(ACTIVO)
  jornada       String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  programa           Programa            @relation(fields: [programaId], references: [id])
  institucion        Institucion         @relation(fields: [institucionId], references: [id])
  sede               Sede                @relation(fields: [sedeId], references: [id])
  aprendices         Aprendiz[]
  actividades        Actividad[]
  asistencias        Asistencia[]
  instructores       InstructorFicha[]
  asignacionesCarga  AsignacionCarga[]
  visitasSeguimiento VisitaSeguimiento[]
  clasesVirtuales    ClaseVirtual[]

  @@map("fichas")
}

// ============================================================
// ACTORES
// ============================================================

model Aprendiz {
  id                   String         @id @default(cuid())
  tipoDocumento        TipoDocumento  @default(CC)
  numeroDocumento      String         @unique
  nombres              String
  apellidos            String
  fechaNacimiento      DateTime?
  genero               String?
  telefono             String?
  emailPersonal        String?
  emailSena            String?
  direccion            String?
  fichaId              String
  estado               EstadoAprendiz @default(EN_FORMACION)
  nivelRiesgo          NivelRiesgo    @default(BAJO)
  porcentajeAsistencia Float          @default(100.0)
  promedioAcumulado    Float          @default(0.0)
  userId               String?        @unique
  creadoEn             DateTime       @default(now())
  actualizadoEn        DateTime       @updatedAt

  user               User?                @relation(fields: [userId], references: [id])
  ficha              Ficha                @relation(fields: [fichaId], references: [id])
  entregas           Entrega[]
  evaluaciones       EvaluacionAprendiz[]
  alertas            AlertaRiesgo[]
  detallesAsistencia RegistroAsistencia[]
  visitasSeguimiento VisitaSeguimiento[]
  excusas            Excusa[]

  @@map("aprendices")
}

model Instructor {
  id              String        @id @default(cuid())
  tipoDocumento   TipoDocumento @default(CC)
  numeroDocumento String        @unique
  nombres         String
  apellidos       String
  email           String        @unique
  telefono        String?
  profesion       String?
  userId          String?       @unique
  estado          Estado        @default(ACTIVO)
  
  // Datos Personales Extendidos
  emailPersonal       String?
  direccionResidencia String?
  municipioResidencia String?
  eps                 String?
  fondoPension        String?
  arl                 String?
  fechaNacimiento     DateTime?
  estadoCivil         String?

  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt

  user              User?             @relation(fields: [userId], references: [id])
  asistencias       Asistencia[]
  actividades       Actividad[]
  entregas          Entrega[]
  fichas            InstructorFicha[]
  asignacionesCarga AsignacionCarga[]
  excusasRevisadas  Excusa[]
  clasesVirtuales   ClaseVirtual[]

  @@map("instructores")
}

model InstructorFicha {
  id           String   @id @default(cuid())
  instructorId String
  fichaId      String
  rolFicha     String   @default("LIDER_TECNICO")
  asignadoEn   DateTime @default(now())

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  ficha      Ficha      @relation(fields: [fichaId], references: [id], onDelete: Cascade)

  @@unique([instructorId, fichaId])
  @@map("instructor_fichas")
}

model AsignacionCarga {
  id                     String   @id @default(cuid())
  instructorId           String
  fichaId                String
  resultadoAprendizajeId String
  asignadoEn             DateTime @default(now())

  instructor           Instructor           @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  ficha                Ficha                @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  resultadoAprendizaje ResultadoAprendizaje @relation(fields: [resultadoAprendizajeId], references: [id], onDelete: Cascade)

  @@unique([instructorId, fichaId, resultadoAprendizajeId])
  @@map("asignaciones_carga")
}

// ============================================================
// ESTRUCTURA ACADÉMICA
// ============================================================

model Competencia {
  id            String          @id @default(cuid())
  codigo        String          @unique
  nombre        String          @db.Text
  tipo          TipoCompetencia @default(TECNICA)
  duracionHoras Int
  estado        Estado          @default(ACTIVO)
  urlGuia       String?         @db.Text
  creadoEn      DateTime        @default(now())
  actualizadoEn DateTime        @updatedAt

  programas             Programa[]
  resultadosAprendizaje ResultadoAprendizaje[]

  @@map("competencias")
}

model ResultadoAprendizaje {
  id            String       @id @default(cuid())
  codigo        String
  nombre        String       @db.Text
  competenciaId String
  fase          FaseProyecto @default(ANALISIS)
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt

  competencia       Competencia          @relation(fields: [competenciaId], references: [id])
  evaluaciones      EvaluacionAprendiz[]
  actividades       Actividad[]
  asignacionesCarga AsignacionCarga[]
  criterios         CriterioEvaluacion[]

  @@map("resultados_aprendizaje")
}

model CriterioEvaluacion {
  id                     String               @id @default(cuid())
  codigo                 String?
  descripcion            String               @db.Text
  resultadoAprendizajeId String
  creadoEn               DateTime             @default(now())
  actualizadoEn          DateTime             @updatedAt

  resultadoAprendizaje   ResultadoAprendizaje @relation(fields: [resultadoAprendizajeId], references: [id], onDelete: Cascade)
  instrumentos           InstrumentoEvaluacion[]

  @@map("criterios_evaluacion")
}

model InstrumentoEvaluacion {
  id                   String             @id @default(cuid())
  nombre               String
  tipo                 String
  criterioEvaluacionId String
  creadoEn             DateTime           @default(now())
  actualizadoEn        DateTime           @updatedAt

  criterioEvaluacion   CriterioEvaluacion @relation(fields: [criterioEvaluacionId], references: [id], onDelete: Cascade)

  @@map("instrumentos_evaluacion")
}

// ============================================================
// EJECUCIÓN
// ============================================================

model Actividad {
  id                     String          @id @default(cuid())
  fichaId                String
  nombre                 String
  descripcion            String?         @db.Text
  instrucciones          String?         @db.Text
  tipo                   TipoActividad   @default(TALLER)
  fechaInicio            DateTime        @default(now())
  fechaVencimiento       DateTime
  estado                 EstadoActividad @default(ACTIVA)
  instructorId           String?
  resultadoAprendizajeId String?
  creadoEn               DateTime        @default(now())
  actualizadoEn          DateTime        @updatedAt

  ficha                Ficha                 @relation(fields: [fichaId], references: [id])
  instructor           Instructor?           @relation(fields: [instructorId], references: [id])
  resultadoAprendizaje ResultadoAprendizaje? @relation(fields: [resultadoAprendizajeId], references: [id])
  entregas             Entrega[]

  @@map("actividades")
}

model Entrega {
  id                String        @id @default(cuid())
  actividadId       String
  aprendizId        String
  fechaEntrega      DateTime      @default(now())
  urlArchivo        String?
  comentario        String?       @db.Text
  estado            EstadoEntrega @default(PENDIENTE)
  calificacion      String?
  retroalimentacion String?       @db.Text
  instructorId      String?
  fechaEvaluacion   DateTime?
  creadoEn          DateTime      @default(now())
  actualizadoEn     DateTime      @updatedAt

  actividad  Actividad   @relation(fields: [actividadId], references: [id])
  aprendiz   Aprendiz    @relation(fields: [aprendizId], references: [id])
  instructor Instructor? @relation(fields: [instructorId], references: [id])

  @@unique([actividadId, aprendizId])
  @@map("entregas")
}

enum EstadoAsistenciaAprendiz {
  PRESENTE
  FALLA
  EXCUSA
}

model Asistencia {
  id             String           @id @default(cuid())
  fichaId        String
  instructorId   String
  fecha          DateTime
  totalPresentes Int              @default(0)
  totalFaltas    Int              @default(0)
  totalExcusas   Int              @default(0)
  observaciones  String?          @db.Text
  estado         EstadoAsistencia @default(PENDIENTE)
  creadoEn       DateTime         @default(now())
  actualizadoEn  DateTime         @updatedAt

  ficha      Ficha                @relation(fields: [fichaId], references: [id])
  instructor Instructor           @relation(fields: [instructorId], references: [id])
  detalles   RegistroAsistencia[]

  @@unique([fichaId, fecha])
  @@map("asistencias")
}

model RegistroAsistencia {
  id            String                   @id @default(cuid())
  asistenciaId  String
  aprendizId    String
  estado        EstadoAsistenciaAprendiz @default(PRESENTE)
  observaciones String?

  asistencia Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  aprendiz   Aprendiz   @relation(fields: [aprendizId], references: [id], onDelete: Cascade)

  @@unique([asistenciaId, aprendizId])
  @@map("registros_asistencia")
}

model EvaluacionAprendiz {
  id                     String           @id @default(cuid())
  aprendizId             String
  resultadoAprendizajeId String
  juicio                 JuicioValorativo @default(PENDIENTE)
  nota                   Float?
  fecha                  DateTime?
  observaciones          String?          @db.Text
  creadoEn               DateTime         @default(now())
  actualizadoEn          DateTime         @updatedAt

  aprendiz             Aprendiz             @relation(fields: [aprendizId], references: [id])
  resultadoAprendizaje ResultadoAprendizaje @relation(fields: [resultadoAprendizajeId], references: [id])

  @@unique([aprendizId, resultadoAprendizajeId])
  @@map("evaluaciones_aprendiz")
}

// ============================================================
// SEGUIMIENTO Y RIESGOS
// ============================================================

model AlertaRiesgo {
  id             String      @id @default(cuid())
  aprendizId     String
  motivo         String
  nivel          NivelRiesgo @default(MEDIO)
  fechaDeteccion DateTime    @default(now())
  gestionada     Boolean     @default(false)
  observaciones  String?     @db.Text
  creadoEn       DateTime    @default(now())
  actualizadoEn  DateTime    @updatedAt

  aprendiz Aprendiz @relation(fields: [aprendizId], references: [id])

  @@map("alertas_riesgo")
}

model VisitaSeguimiento {
  id String @id @default(cuid())

  aprendizId String?
  aprendiz   Aprendiz? @relation(fields: [aprendizId], references: [id])
  fichaId    String?
  ficha      Ficha?    @relation(fields: [fichaId], references: [id])

  institucionNombre String?
  fecha             DateTime
  responsable       String
  novedades         Int          @default(0)
  observaciones     String?      @db.Text
  estado            EstadoVisita @default(PROGRAMADA)
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  @@map("visitas_seguimiento")
}

// ============================================================
// ADMINISTRACIÓN Y SEGURIDAD
// ============================================================

model User {
  id               String     @id @default(cuid())
  nombre           String
  email            String     @unique
  passwordHash     String
  rol              String     @default("APRENDIZ")
  institucionId    String? // <-- Nuevo campo para multi-tenancy y prevención de IDOR
  sedeId           String? // <-- Campo para enlazar usuario a una sede específica (ej: APOYO_COORDINACION)
  estado           Estado     @default(ACTIVO)
  ultimoAcceso     DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean    @default(false)
  last2FADate      DateTime?
  fotoPerfil       String?    @db.Text
  
  // Integración Google Drive
  googleDriveLinked    Boolean @default(false)
  googleDriveFolderId  String?
  googleRefreshToken   String? @db.Text

  // Firma Digital para Documentos
  firmaDigitalUrl      String? @db.Text



  creadoEn         DateTime   @default(now())
  actualizadoEn    DateTime   @updatedAt

  institucion        Institucion?        @relation(fields: [institucionId], references: [id])
  sede               Sede?               @relation(fields: [sedeId], references: [id])
  instructor         Instructor?
  aprendiz           Aprendiz?
  auditLog           AuditLog[]
  notificaciones     Notificacion[]
  mensajesEnviados   Mensaje[]            @relation("MensajesEnviados")
  mensajesRecibidos  Mensaje[]            @relation("MensajesRecibidos")
  sessionLogs        SessionLog[]
  documentoEmpleados DocumentoEmpleado[]
  solicitudCartas    SolicitudCarta[]
  lecturasGlobales   MensajeLeido[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  creadoEn  DateTime @default(now())

  user User @relation(fields: [email], references: [email], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuditLog {
  id                String   @id @default(cuid())
  userId            String?
  modulo            String
  accion            String
  detalle           String   @db.Text
  entidad           String?  // Ej. "Usuario", "Actividad"
  entidadId         String?  // ID del registro alterado
  valoresAnteriores Json?    // Estado antes del cambio
  valoresNuevos     Json?    // Estado después del cambio
  ip                String?
  fecha             DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ============================================================
// ENUMS
// ============================================================

enum Estado {
  ACTIVO
  INACTIVO
}

enum EstadoAprendiz {
  EN_FORMACION
  EGRESADO
  RETIRADO
  APLAZADO
  CANCELADO
}

enum NivelRiesgo {
  BAJO
  MEDIO
  ALTO
}

enum NivelFormacion {
  TECNICO
  TECNOLOGO
  OPERARIO
}

enum TipoDocumento {
  CC
  TI
  CE
  PP
}

enum TipoCompetencia {
  TECNICA
  TRANSVERSAL
  BASICA
}

enum FaseProyecto {
  ANALISIS
  PLANEACION
  EJECUCION
  EVALUACION
}

enum TipoActividad {
  TALLER
  PROYECTO
  FORO
  QUIZ
}

enum EstadoActividad {
  ACTIVA
  CERRADA
  BORRADOR
  PUBLICADA
}

enum EstadoEntrega {
  PENDIENTE
  CALIFICADA
  TARDIA
  APROBADA
  NO_APROBADA
}

enum EstadoAsistencia {
  PENDIENTE
  REGISTRADA
}

enum JuicioValorativo {
  APROBADO
  DEFICIENTE
  PENDIENTE
}

enum EstadoVisita {
  PROGRAMADA
  REALIZADA
  APLAZADA
}

enum ModalidadPrograma {
  PRESENCIAL
  VIRTUAL
  DISTANCIA
  COMBINADO
}

model Documento {
  id            String   @id @default(cuid())
  nombre        String
  tipo          String   @default("OTRO")
  institucionId String?
  url           String
  tamanoBytes   Int?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  institucion   Institucion? @relation(fields: [institucionId], references: [id])

  @@map("documentos")
}

// ============================================================
// NUEVOS ACTORES Y SISTEMA
// ============================================================

model Docente {
  id              String        @id @default(cuid())
  tipoDocumento   TipoDocumento @default(CC)
  numeroDocumento String        @unique
  nombres         String
  apellidos       String
  email           String        @unique
  telefono        String?
  profesion       String?
  institucionId   String
  estado          Estado        @default(ACTIVO)
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt

  institucion Institucion @relation(fields: [institucionId], references: [id], onDelete: Cascade)

  @@map("docentes")
}

model Notificacion {
  id       String   @id @default(cuid())
  userId   String
  titulo   String
  mensaje  String   @db.Text
  leida    Boolean  @default(false)
  tipo     String   @default("INFO")
  enlace   String?
  creadoEn DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notificaciones")
}

model ConfiguracionSistema {
  id                  String   @id @default("global")
  anioLectivo         Int      @default(2026)
  trimestre           Int      @default(3)
  regional            String   @default("SENA Regional Magdalena")
  ciudad              String   @default("Santa Marta")
  faltasRiesgoAlto    Int      @default(3)
  asistenciaMinima    Int      @default(75)
  promedioMinimo      Float    @default(3.0)
  diasEntrega         Int      @default(7)
  duracionSesionHoras Int      @default(8)
  intentosLogin       Int      @default(5)
  diasMaximoExcusa    Int      @default(3) // EX-2: días hábiles máx para radicar una excusa

  // Campos de Marca Blanca (Branding)
  nombreInstitucion   String   @default("SENA")
  nombreSoftware      String   @default("GSS - Media Técnica")
  colorPrincipal      String   @default("#39A900") // Verde SENA
  colorSecundario     String   @default("#00304D") // Azul SENA
  logoUrl             String?  @default("/logo-sena.png")

  actualizadoEn       DateTime @updatedAt

  @@map("configuracion_sistema")
}

model Mensaje {
  id         String   @id @default(cuid())
  emisorId   String
  receptorId String?  // Opcional si es global
  esGlobal   Boolean  @default(false)
  contenido  String   @db.Text
  adjuntoUrl String?  // MS-3: Adjuntos en mensajes
  leido      Boolean  @default(false)
  creadoEn   DateTime @default(now())

  replyToId  String?  // MS-2: ID del mensaje al que responde
  replyTo    Mensaje? @relation("Respuestas", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Mensaje[] @relation("Respuestas")

  emisor           User           @relation("MensajesEnviados", fields: [emisorId], references: [id], onDelete: Cascade)
  receptor         User?          @relation("MensajesRecibidos", fields: [receptorId], references: [id], onDelete: Cascade)
  lecturasGlobales MensajeLeido[]

  @@map("mensajes")
}

model MensajeLeido {
  id        String   @id @default(cuid())
  mensajeId String
  userId    String
  leidoEn   DateTime @default(now())

  mensaje Mensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mensajeId, userId])
  @@map("mensajes_leidos")
}

model ClaseVirtual {
  id                 String   @id @default(cuid())
  titulo             String
  descripcion        String?  @db.Text
  enlaceUrl          String?  @db.Text
  zoomMeetingId      String?
  fechaInicio        DateTime
  duracionMin        Int
  fichaId            String
  instructorId       String
  estado             Estado   @default(ACTIVO)
  creadoEn           DateTime @default(now())

  ficha      Ficha      @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@map("clases_virtuales")
}

model Rol {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?  @db.Text
  permisos    Json?
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("roles")
}

model SessionLog {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String
  ipAddress    String?
  userAgent    String?
  isActive     Boolean   @default(true)
  trustedUntil DateTime? // Si está seteado y no ha expirado, no pide 2FA
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_logs")
}

model Excusa {
  id                    String    @id @default(cuid())
  aprendizId            String
  motivo                String
  descripcion           String?   @db.Text
  archivoUrl            String?
  fechaInicio           DateTime?
  fechaFin              DateTime?
  estado                String    @default("PENDIENTE") // PENDIENTE, APROBADA, RECHAZADA, APELADA
  observacionInstructor String?   @db.Text
  apelacion             String?   @db.Text  // EX-5: Apelación de excusa rechazada
  apelacionRespuesta    String?   @db.Text  // EX-5: Respuesta a la apelación
  instructorRevisorId   String?
  fecha                 DateTime  @default(now())
  creadoEn              DateTime  @default(now())
  actualizadoEn         DateTime  @updatedAt

  aprendiz Aprendiz @relation(fields: [aprendizId], references: [id])
  instructorRevisor Instructor? @relation(fields: [instructorRevisorId], references: [id])

  @@map("excusas")
}

model DocumentoEmpleado {
  id               String    @id @default(cuid())
  userId           String
  tipoDocumento    String // HV, CONTRATO, CERTIFICADO_ACADEMICO, DOCUMENTO_IDENTIDAD, OTRO
  nombre           String
  urlArchivo       String
  estado           String    @default("VIGENTE") // VIGENTE, VENCIDO, RECHAZADO
  fechaVencimiento DateTime?
  creadoEn         DateTime  @default(now())
  actualizadoEn    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documentos_empleados")
}

model SolicitudCarta {
  id            String   @id @default(cuid())
  userId        String
  tipoCarta     String // LABORAL, SALARIO, ETC
  motivo        String?  @db.Text
  dirigidoA     String?
  estado        String   @default("PENDIENTE") // PENDIENTE, GENERADA, RECHAZADA
  urlCarta      String?
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("solicitudes_cartas")
}
